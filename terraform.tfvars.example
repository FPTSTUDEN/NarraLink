# Example variables file for development environment
aws_region        = "us-east-1"
aws_endpoint_url  = "http://localhost:4566"
aws_access_key_id = "test"
aws_secret_access_key = "test"
bucket_name       = "narrative-store-dev"
stream_name       = "user-events-dev"
dynamodb_table    = "narrative-state-dev"
dynamodb_prefs    = "narrative-preferences-dev"
lambda_name       = "narrative-generator"
bedrock_lambda_name = "narrative-bedrock-generator"
use_mock_ai       = true
environment       = "dev"

tags = {
  Project     = "NarrativeEngine"
  Environment = "dev"
  ManagedBy   = "Terraform"
  Team        = "Engineering"
}
